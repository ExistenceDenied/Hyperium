# Runtime / generated state — never committed (financial + workspace data stays local)
apps/*/data/
apps/*/workspace/
apps/**/logs/
**/*.log

# Dependencies / build output
**/node_modules/
**/.venv/
**/dist/
**/build/
**/*.egg-info/

# Caches
**/.pytest_cache/
**/.ruff_cache/
**/__pycache__/
**/.mypy_cache/

# OS / editor
Thumbs.db
.DS_Store
.idea/
.vscode/
